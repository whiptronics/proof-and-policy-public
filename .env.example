# Copy to .env (ignored by Git) or set these in your shell. Placeholders only.
# None of these are needed to USE a published release. They are optional for
# reproducing it from upstream sources.

# Census Data API key. Not used by the v0.1 preview build, which reads Census
# bulk files; supported for future API-based adapters. Redacted from logs and manifests.
CENSUS_API_KEY=

# BLS Public Data API v2 key. Optional: without it the CPI adapter uses the
# keyless v1 API (lower daily query limit). Redacted from logs and manifests.
BLS_API_KEY=

# Optional override for where data/raw, data/processed and dist live.
# ALCOHOL_DATA_HOME=
